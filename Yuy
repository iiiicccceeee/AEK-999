local Fly_Active = false
local Speed_Active = false
local AutoFarm_Active = false
local FlyBodyVel, FlyBodyGyro

--------------------------------------------------------
-- UI COMPONENT CREATORS
--------------------------------------------------------
local function CreateToggleRow(labelTitle, callback)
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, 0, 0, 45)
    Row.BackgroundColor3 = Color3.fromRGB(25, 15, 40)
    Row.Parent = Scroll

    local RowCorner = Instance.new("UICorner")
    RowCorner.CornerRadius = UDim.new(0, 8)
    RowCorner.Parent = Row

    local Text = Instance.new("TextLabel")
    Text.Parent = Row
    Text.Position = UDim2.new(0, 12, 0, 0)
    Text.Size = UDim2.new(0.7, 0, 1, 0)
    Text.Text = labelTitle
    Text.TextColor3 = Color3.fromRGB(255, 255, 255)
    Text.TextSize = 14
    Text.Font = Enum.Font.SourceSansBold
    Text.TextXAlignment = Enum.TextXAlignment.Left
    Text.BackgroundTransparency = 1

    local Switch = Instance.new("TextButton")
    Switch.Parent = Row
    Switch.Position = UDim2.new(0.73, 0, 0.2, 0)
    Switch.Size = UDim2.new(0.22, 0, 0.6, 0)
    Switch.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    Switch.Text = "ปิด"
    Switch.TextColor3 = Color3.fromRGB(255, 255, 255)
    Switch.Font = Enum.Font.SourceSansBold

    local SwitchCorner = Instance.new("UICorner")
    SwitchCorner.CornerRadius = UDim.new(0, 6)
    SwitchCorner.Parent = Switch

    local state = false
    Switch.MouseButton1Click:Connect(function()
        state = not state
        if state then
            Switch.BackgroundColor3 = Color3.fromRGB(160, 32, 240)
            Switch.Text = "เปิด"
        else
            Switch.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            Switch.Text = "ปิด"
        end
        callback(state)
    end)
end

local function CreateButtonRow(labelTitle, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 45)
    Btn.BackgroundColor3 = Color3.fromRGB(45, 15, 70)
    Btn.Text = labelTitle
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.TextSize = 14
    Btn.Font = Enum.Font.SourceSansBold
    Btn.Parent = Scroll

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 8)
    BtnCorner.Parent = Btn

    Btn.MouseButton1Click:Connect(callback)
end

--------------------------------------------------------
-- FUNCTION 1: MOVE OPTIONS
--------------------------------------------------------

-- 1. บิน 🕊️
CreateToggleRow("บิน🕊️", function(val)
    Fly_Active = val
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    if Fly_Active then
        FlyBodyVel = Instance.new("BodyVelocity")
        FlyBodyVel.MaxForce = Vector3.new(4e5, 4e5, 4e5)
        FlyBodyVel.Velocity = Vector3.new(0, 0, 0)
        FlyBodyVel.Parent = char.HumanoidRootPart

        FlyBodyGyro = Instance.new("BodyGyro")
        FlyBodyGyro.MaxTorque = Vector3.new(4e5, 4e5, 4e5)
        FlyBodyGyro.CFrame = char.HumanoidRootPart.CFrame
        FlyBodyGyro.Parent = char.HumanoidRootPart
    else
        if FlyBodyVel then FlyBodyVel:Destroy() end
        if FlyBodyGyro then FlyBodyGyro:Destroy() end
    end
end)

-- 2. วิ่งเร็ว 🏃
CreateToggleRow("วิ่งเร็ว🏃", function(val)
    Speed_Active = val
end)

