--------------------------------------------------------
-- FUNCTION 3: TELEPORTS
--------------------------------------------------------

-- 4. เทเลพอร์ตไปด่านสุดท้าย 🏁
CreateButtonRow("เทเลพอร์ตไปด่านสุดท้าย🏁", function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local targetPos = nil
    for _, v in pairs(Workspace:GetDescendants()) do
        if v.Name:lower():find("finish") or v.Name:lower():find("laststage") or v.Name:lower():find("endzone") then
            targetPos = v.CFrame
            break
        end
    end
    
    if targetPos then
        char.HumanoidRootPart.CFrame = targetPos + Vector3.new(0, 3, 0)
    else
        -- Default High Teleport / Fallback
        char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0, 500, -1000)
    end
end)

-- 5. เทเลพอร์ตไปไข่ที่ดีที่สุด 🥚✨
CreateButtonRow("เทเลพอร์ตไปไข่ที่ดีที่สุด🥚✨", function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local bestEgg = nil
    for _, v in pairs(Workspace:GetDescendants()) do
        if v.Name:lower():find("egg") or v.Name:lower():find("best") then
            if v:IsA("BasePart") or v:IsA("Model") then
                bestEgg = v
            end
        end
    end
    
    if bestEgg then
        local pos = bestEgg:IsA("BasePart") and bestEgg.CFrame or bestEgg:GetPivot()
        char.HumanoidRootPart.CFrame = pos * CFrame.new(0, 3, -5)
    end
end)

--------------------------------------------------------
-- LOOPS & EXECUTORS
--------------------------------------------------------

-- Movement Loop (Speed & Flying)
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        if Speed_Active then
            char.Humanoid.WalkSpeed = 50
        else
            char.Humanoid.WalkSpeed = 16
        end
        
        if Fly_Active and FlyBodyVel and FlyBodyGyro and char:FindFirstChild("HumanoidRootPart") then
            local cam = Workspace.CurrentCamera
            FlyBodyGyro.CFrame = cam.CFrame
            FlyBodyVel.Velocity = cam.CFrame.LookVector * 60
        end
    end
end)

-- Auto Farm Money Loop
task.spawn(function()
    while task.wait(0.2) do
        if AutoFarm_Active and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            for _, coin in pairs(Workspace:GetDescendants()) do
                if coin.Name:lower():find("coin") or coin.Name:lower():find("money") or coin.Name:lower():find("gem") then
                    if coin:IsA("BasePart") then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = coin.CFrame
                        task.wait(0.1)
                    end
                end
            end
        end
    end
end)
